{
  "name": "vscode-fast-index",
  "displayName": "Fast Project Indexer ",
  "description": "Lightning-fast text search for VS Code using a background inverted trigram index.",
  "publisher": "eric",
  "version": "0.29.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericzaev/vscode-fast-index.git"
  },
  "keywords": [
    "search",
    "fast",
    "index",
    "large project"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:fast-index.sidebar",
    "onCommand:vscode-fast-index.buildIndex"
  ],
  "license": "MIT",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fast-index-explorer",
          "title": "Fast Index",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "fast-index-explorer": [
        {
          "type": "webview",
          "id": "fast-index.sidebar",
          "name": "Fast Index Search"
        },
        {
          "id": "fast-index.results",
          "name": "Results"
        },
        {
          "id": "fast-index.pins",
          "name": "Pinned Searches"
        },
        {
          "type": "webview",
          "id": "fast-index.settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-fast-index.buildIndex",
        "title": "Fast Index: Build Project Index"
      },
      {
        "command": "vscode-fast-index.lockResults",
        "title": "Lock Results",
        "icon": "$(lock)"
      },
      {
        "command": "vscode-fast-index.unlockResults",
        "title": "Unlock Results",
        "icon": "$(unlock)"
      },
      {
        "command": "vscode-fast-index.toggleSettings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscode-fast-index.showMenu",
        "title": "Menu",
        "icon": "$(menu)"
      },
      {
        "command": "vscode-fast-index.showLog",
        "title": "Fast Index: Show Search Log",
        "icon": "$(output)"
      },
      {
        "command": "vscode-fast-index.openResultsInEditor",
        "title": "Fast Index: Open Results in Editor",
        "icon": "$(book)"
      },
      {
        "command": "vscode-fast-index.openMatch",
        "title": "Fast Index: Open Match",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vscode-fast-index.replaceMatch",
        "title": "Replace This Match…",
        "icon": "$(replace)"
      },
      {
        "command": "vscode-fast-index.applyPin",
        "title": "Restore Pinned Search",
        "icon": "$(pin)"
      },
      {
        "command": "vscode-fast-index.removePin",
        "title": "Remove Pinned Search",
        "icon": "$(trash)"
      },
      {
        "command": "vscode-fast-index.openPanel",
        "title": "Fast Index: Open Search Panel",
        "icon": "$(zap)"
      },
      {
        "command": "vscode-fast-index.toggleReplace",
        "title": "Replace",
        "icon": "$(replace)"
      },
      {
        "command": "vscode-fast-index.importIgnoreFile",
        "title": "Fast Index: Load Ignore File for Indexing",
        "icon": "$(file)"
      },
      {
        "command": "vscode-fast-index.openCacheFolder",
        "title": "Fast Index: Open Index Folder in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vscode-fast-index.cancelIndex",
        "title": "Fast Index: Cancel Indexing",
        "icon": "$(stop-circle)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vscode-fast-index.replaceMatch",
          "when": "view == fast-index.results && viewItem == match",
          "group": "1_modification@1"
        },
        {
          "command": "vscode-fast-index.openMatch",
          "when": "view == fast-index.results && viewItem == match",
          "group": "navigation@1"
        },
        {
          "command": "vscode-fast-index.applyPin",
          "when": "view == fast-index.pins && viewItem == pin",
          "group": "navigation@1"
        },
        {
          "command": "vscode-fast-index.removePin",
          "when": "view == fast-index.pins && viewItem == pin",
          "group": "1_modification@1"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-fast-index.openPanel",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "vscode-fast-index.unlockResults",
          "when": "view == fast-index.sidebar && fastIndex.locked",
          "group": "navigation@1"
        },
        {
          "command": "vscode-fast-index.lockResults",
          "when": "view == fast-index.sidebar && !fastIndex.locked",
          "group": "navigation@1"
        },
        {
          "command": "vscode-fast-index.toggleSettings",
          "when": "view == fast-index.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "vscode-fast-index.openResultsInEditor",
          "when": "view == fast-index.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "vscode-fast-index.toggleReplace",
          "when": "view == fast-index.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "vscode-fast-index.showMenu",
          "when": "view == fast-index.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Fast Indexer",
      "properties": {
        "fastIndex.includeExtensions": {
          "type": "string",
          "default": "",
          "description": "Comma-separated list of file extensions to index (e.g., ts,js,md). Leave empty to index all extensions."
        },
        "fastIndex.excludePatterns": {
          "type": "string",
          "default": "{**/node_modules/**,**/.git/**,**/.*/**,**/dist/**,**/out/**,**/Binaries/**,**/Intermediate/**,**/DerivedDataCache/**,**/Saved/**,**/Content/**,**/*.png,**/*.jpg,**/*.jpeg,**/*.svg,**/*.uasset,**/*.umap}",
          "description": "File and folder patterns to ignore during indexing (Glob format). Hidden folders (names starting with '.') are excluded by default."
        },
        "fastIndex.ignoreFiles": {
          "type": "string",
          "default": "",
          "description": "Comma-separated .gitignore-style files whose rules are excluded from indexing (e.g., .gitignore, .loreignore). Relative paths resolve against every workspace folder; absolute paths are read once. Rules are re-read on every build and when the file changes, and apply to the file watcher as well as to builds. Run \"Fast Index: Load Ignore File for Indexing\" to add one."
        },
        "fastIndex.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "description": "Maximum file size in kilobytes to index. Files larger than this will be skipped."
        },
        "fastIndex.maxResultsPerFile": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Maximum matching lines shown per file (0 = no limit). Keeps one huge file from filling the whole result list."
        },
        "fastIndex.maxResults": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of search results to display."
        },
        "fastIndex.debounceDelay": {
          "type": "number",
          "default": 250,
          "description": "Input delay (in milliseconds) before triggering the search."
        },
        "fastIndex.resultContextLines": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 50,
          "description": "Lines shown above and below each match in the results editor (2 = two above, two below)."
        },
        "fastIndex.persistPinnedSearches": {
          "type": "boolean",
          "default": true,
          "description": "Keep pinned searches in the workspace storage so they survive a restart. When off, pins live only for the current session."
        },
        "fastIndex.followEditor": {
          "type": "boolean",
          "default": true,
          "description": "Keep the search box in sync with the editor: use the selection, or the word under the cursor, while the panel is open."
        },
        "fastIndex.maxRecentSearches": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "description": "How many recent searches the search box remembers (0 disables the history)."
        },
        "fastIndex.autoOpenResults": {
          "type": "boolean",
          "default": false,
          "description": "Open the results editor automatically whenever a search finds matches and that editor is not already open. It appears without taking focus, so typing in the panel continues undisturbed."
        },
        "fastIndex.resultsDock": {
          "type": "string",
          "enum": [
            "current",
            "below",
            "right"
          ],
          "enumDescriptions": [
            "Share the active editor group (the results tab replaces what is shown there)",
            "Open in its own group below the active document (split view, document stays visible)",
            "Open in its own group to the right of the active document"
          ],
          "default": "current",
          "description": "Where the results editor is opened the first time. A tab that is already open is always brought forward where it lives."
        },
        "fastIndex.autoSearchFromResults": {
          "type": "boolean",
          "default": false,
          "description": "Let clicking or selecting inside the results editor update the search box (Auto Search). Off by default, so selecting a result line there never disturbs your query."
        },
        "fastIndex.showContextLine": {
          "type": "boolean",
          "default": true,
          "description": "Show the matched line of code (the hit's context line) under each result in the panel. Turn it off for a compact file-and-line list."
        },
        "fastIndex.hoverHighlightColor": {
          "type": "string",
          "default": "charts.yellow",
          "enum": [
            "charts.yellow",
            "list.highlightForeground",
            "charts.blue",
            "charts.green",
            "charts.orange",
            "charts.purple",
            "charts.red",
            "editorInfo.foreground"
          ],
          "enumDescriptions": [
            "Theme chart yellow (default)",
            "The theme's list highlight color",
            "Theme chart blue",
            "Theme chart green",
            "Theme chart orange",
            "Theme chart purple",
            "Theme chart red",
            "The theme's info foreground"
          ],
          "description": "Theme color used to highlight the hovered result's file row and its folders in the results tree."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run clean && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/vscode": "1.108.1",
    "typescript": "^5.9.3"
  }
}
